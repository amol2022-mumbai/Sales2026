# ==============================================================================
# Sales Management CRM - Environment Configuration (Example)
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ==============================================================================

# ---- Server ----
NODE_ENV=development
PORT=4000
# Public base URL of the API server (used for CORS allow-list, links, etc.)
API_BASE_URL=http://localhost:4000
# Comma-separated list of allowed CORS origins (frontend dev server / preview domain)
CORS_ORIGINS=http://localhost:5173
# Number of trusted reverse-proxy hops for client IP detection (used by rate
# limiting). Set 0 when not behind a proxy, 1 when behind a single proxy.
TRUST_PROXY=1

# ---- Database ----
# Path to the SQLite database file. Relative paths resolve from server/.
DB_PATH=./data/crm.db

# ---- Auth / Sessions ----
# Secret used to sign/verify JWT access tokens. Use a long random string.
# Generate with: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-secret
# Access token lifetime (e.g. 8h, 1d)
JWT_EXPIRES_IN=8h

# ---- Super Admin (created on first run / seed) ----
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_COMPANY_NAME=Acme Corp

# ---- White-label / branding defaults ----
# Fallback branding used when no client (tenant) branding is configured. Per-client
# branding (name, logo, favicon, brand colour, domain) is managed in the Super
# Admin UI and stored in the database - never hard-coded.
APP_NAME=SalesDesk CRM
APP_BRAND_COLOR=#4f46e5
APP_LOGO_URL=
APP_FAVICON_URL=

# ---- Future integrations (not used in Phase 1, reserved for Phase 2+) ----
# SMTP_* for email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- AI Assistant (Phase 11) ----
# LLM provider for the AI Sales Assistant. Supported values include `openai`
# and `deepseek` (OpenAI-compatible chat completions). When these are left
# blank the assistant still works: it answers from real tenant data using a
# deterministic, rule-based engine (no external calls, no secrets involved).
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Optional: override the OpenAI-compatible API base URL (defaults are derived
# from AI_PROVIDER). Set this for self-hosted / proxy endpoints.
AI_BASE_URL=
# Optional: timeout (ms) for a single LLM request. Defaults to 30000.
AI_TIMEOUT_MS=30000

# Payment / invoicing integrations (Phase 2+)
PAYMENT_GATEWAY_KEY=
