# ==============================================================================
# Sales Management CRM - Environment Configuration (Example)
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# See docs/DEPLOYMENT.md for the full production checklist.
# ==============================================================================

# ---- Server ----
NODE_ENV=development
PORT=4000
# Public base URL of the API server (used for links and as the fallback origin).
API_BASE_URL=http://localhost:4000
# Comma-separated list of allowed CORS origins (your frontend / app domain).
CORS_ORIGINS=http://localhost:5173
# Number of trusted reverse-proxy hops for client IP detection (rate limiting).
# 0 = not behind a proxy, 1 = behind a single proxy/load balancer.
TRUST_PROXY=1

# ---- Database ----
# Path to the SQLite database file. Relative paths resolve from server/.
DB_PATH=./data/crm.db

# ---- Auth / Sessions ----
# Secret used to sign/verify JWT access tokens. REQUIRED. Generate with:
#   openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-secret
# Access token lifetime (e.g. 8h, 1d)
JWT_EXPIRES_IN=8h

# ---- Super Admin (created on first run / seed) ----
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@example.com
# MUST be changed from this placeholder in production (boot refuses to start
# with the default value when NODE_ENV=production).
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_COMPANY_NAME=Acme Corp

# ---- White-label / branding defaults ----
# Fallback branding used when no client (tenant) branding is configured.
APP_NAME=SalesDesk CRM
APP_BRAND_COLOR=#4f46e5
APP_LOGO_URL=
APP_FAVICON_URL=

# ---- AI Assistant ----
# LLM provider for the AI Sales Assistant. Supported values include `openai`
# and `deepseek` (OpenAI-compatible chat completions). When left blank the
# assistant answers from real tenant data using a deterministic rule-based
# engine (no external calls, no secrets involved).
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_MS=30000

# ---- Payments (billing / subscriptions) ----
# Provider identifier (informational; the flow is generic). Default: stripe.
PAYMENT_PROVIDER=stripe
# test | live. Recorded on checkout sessions; does not gate verification.
PAYMENT_MODE=test
# Secret key for the payment provider. When empty, checkout runs in mock mode
# (safe for offline/demo). When set, real webhooks are required to apply a
# payment; the frontend can never set payment state directly.
PAYMENT_SECRET_KEY=
# Webhook signing secret used to verify inbound payment webhooks. REQUIRED in
# production whenever PAYMENT_SECRET_KEY is set (boot refuses to start
# otherwise). Inbound webhooks without a valid signature are always rejected.
PAYMENT_WEBHOOK_SECRET=
# Force mock checkout (ignored when PAYMENT_SECRET_KEY is set).
PAYMENT_MOCK=0

# ---- Email / notifications ----
# Notifications are delivered in-app (no email provider wired yet). The SMTP_*
# variables below are reserved for a future email integration and are currently
# unused by the application.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
