# ==============================================================================
# Sales Management CRM - Production Environment Configuration (Example)
# ------------------------------------------------------------------------------
# This is the reference for a PRODUCTION deployment. Copy it to `.env` on the
# production host and fill in real values. NEVER commit the real `.env` file.
#
# ALL SECRETS BELOW ARE SAFE PLACEHOLDERS. Replace every value marked
# <REPLACE ...> before deploying. Do not use the placeholder values in
# production — the server refuses to start with them (see section 2 of
# docs/DEPLOYMENT.md).
# ==============================================================================

# ---------------------------------------------------------------------------
# Core / Server
# ---------------------------------------------------------------------------
# MUST be `production`. Enables strict secret validation, production logging
# (morgan "combined"), gzip compression and serving of the built SPA.
NODE_ENV=production

# Listen port (default 4000).
PORT=4000

# Public base URL of the API server. Used to build absolute links and as the
# fallback origin. Replace with your real API domain (no trailing slash).
API_BASE_URL=https://api.example.com

# Comma-separated allow-list of frontend origins (exact origins). The API
# rejects cross-origin browser requests from origins not listed here.
CORS_ORIGINS=https://app.example.com

# Number of trusted reverse-proxy hops for client IP detection (rate limiting).
# 0 = not behind a proxy, 1 = behind a single proxy/load balancer (recommended).
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Path to the SQLite database file. Relative paths resolve from server/.
# Use an absolute path on a persistent volume outside the web root.
DB_PATH=./data/crm.db

# ---------------------------------------------------------------------------
# Auth / Sessions
# ---------------------------------------------------------------------------
# REQUIRED. Secret used to sign/verify JWT access tokens. Generate a strong
# random value and paste it here:
#   openssl rand -hex 48
# The server refuses to start in production if this is missing or left as a
# placeholder.
JWT_SECRET=<REPLACE_WITH_OPENSSL_RAND_HEX_48>

# Access token lifetime (e.g. 8h, 12h, 1d).
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------------------
# Super Admin (seeded on first run / `npm run seed`)
# ---------------------------------------------------------------------------
SEED_ADMIN_NAME=Super Admin

# Login email for the platform Super Admin. Replace with your admin email.
SEED_ADMIN_EMAIL=admin@example.com

# REQUIRED. One-time bootstrap password for the Super Admin. The server refuses
# to start in production if this is left as the default `ChangeMe123!`.
# Use a strong unique password and change it after first login.
SEED_ADMIN_PASSWORD=<REPLACE_WITH_STRONG_ADMIN_PASSWORD>

# Name of the seed client company created on first run.
SEED_COMPANY_NAME=Acme Corp

# ---------------------------------------------------------------------------
# White-label / branding defaults
# ---------------------------------------------------------------------------
# Fallback branding used when no client (tenant) branding is configured.
APP_NAME=SalesDesk CRM
APP_BRAND_COLOR=#4f46e5
APP_LOGO_URL=
APP_FAVICON_URL=

# Public base URL of the app (no trailing slash). Used to build absolute links
# in emails (e.g. the company-admin invitation link). Replace with your real
# frontend/app domain.
APP_URL=https://app.example.com

# ---------------------------------------------------------------------------
# AI Assistant (optional)
# ---------------------------------------------------------------------------
# LLM provider for the AI Sales Assistant (`openai` or `deepseek`). Leave blank
# to run the deterministic offline assistant (no external calls or secrets).
AI_PROVIDER=
AI_API_KEY=<REPLACE_WITH_AI_API_KEY>
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Payments / billing (optional — leave empty for mock checkout)
# ---------------------------------------------------------------------------
# Provider identifier (default `stripe`).
PAYMENT_PROVIDER=stripe

# `test` or `live`.
PAYMENT_MODE=live

# Secret key for the payment provider. Empty = mock checkout (safe for demos).
# When set, real webhooks are required to apply a payment.
PAYMENT_SECRET_KEY=<REPLACE_WITH_PAYMENT_SECRET_KEY>

# REQUIRED whenever PAYMENT_SECRET_KEY is set. Webhook signing secret used to
# verify inbound payment webhooks. The server refuses to start in production if
# the secret key is set but this is missing.
PAYMENT_WEBHOOK_SECRET=<REPLACE_WITH_PAYMENT_WEBHOOK_SECRET>

# Force mock checkout. Ignored when PAYMENT_SECRET_KEY is set.
PAYMENT_MOCK=0

# ---------------------------------------------------------------------------
# Email / notifications (SMTP)
# ---------------------------------------------------------------------------
# Outbound SMTP used to send invitation emails. When SMTP_HOST or SMTP_FROM is
# empty, email is disabled and the invitation link is returned in the API
# response for manual sharing.
SMTP_HOST=smtp.example.com
SMTP_PORT=587

# Use implicit TLS (true) or STARTTLS (false). Set to 1 for port 465.
SMTP_SECURE=0

SMTP_USER=no-reply@example.com

# SMTP password / app-specific password. For Gmail this is an "App Password",
# not your account password. Never commit the real value.
SMTP_PASS=<REPLACE_WITH_SMTP_APP_PASSWORD>

# "From" address for outbound mail.
SMTP_FROM=SalesDesk CRM <no-reply@example.com>

# ---------------------------------------------------------------------------
# Temporary credentials (Super Admin "Generate Temporary Credentials")
# ---------------------------------------------------------------------------
# How long a generated temporary password stays valid, in hours. After this
# window the Super Admin must generate new credentials for that Company Admin.
TEMP_CREDENTIAL_TTL_HOURS=24
